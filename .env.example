# Docker Compose project identity
COMPOSE_PROJECT_NAME=discover_qellem

# PostgreSQL
POSTGRES_DB=discover_qellem
POSTGRES_USER=discover_qellem
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_CONN_MAX_AGE=0

# Django/Wagtail
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cms
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000
WAGTAIL_SITE_NAME="Discover Qellem"

# Cross-origin API access for the local frontend (development settings only).
DJANGO_CORS_ENABLED=true
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local service ports and startup readiness
CMS_HOST_PORT=8000
WEB_HOST_PORT=3000
POSTGRES_STARTUP_TIMEOUT=60

# CMS API origins used by Next.js server-side and browser-side requests
CMS_API_URL=http://cms:8000/api/v2/
NEXT_PUBLIC_CMS_URL=http://localhost:8000
